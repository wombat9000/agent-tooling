{
  "id": "liskov-substitution-bad",
  "description": "ReadOnlyArchiveStore implements KeyValueStore by throwing UnsupportedOperationError on writes, forcing callers to branch with instanceof checks",
  "rubric": "solid",
  "files": {
    "storage.ts": [
      "export interface KeyValueStore {",
      "  get(key: string): string | null;",
      "  set(key: string, value: string): void;",
      "  delete(key: string): void;",
      "}"
    ],
    "read-only-archive-store.ts": [
      "import type { KeyValueStore } from './storage';",
      "",
      "export class ReadOnlyArchiveStore implements KeyValueStore {",
      "  private readonly data: ReadonlyMap<string, string>;",
      "",
      "  constructor(initial: ReadonlyMap<string, string>) {",
      "    this.data = new Map(initial);",
      "  }",
      "",
      "  get(key: string): string | null {",
      "    return this.data.get(key) ?? null;",
      "  }",
      "",
      "  set(_key: string, _value: string): void {",
      "    throw new Error('UnsupportedOperation: ReadOnlyArchiveStore is immutable');",
      "  }",
      "",
      "  delete(_key: string): void {",
      "    throw new Error('UnsupportedOperation: ReadOnlyArchiveStore is immutable');",
      "  }",
      "}"
    ],
    "cache-service.ts": [
      "import { ReadOnlyArchiveStore } from './read-only-archive-store';",
      "import type { KeyValueStore } from './storage';",
      "",
      "export function syncCacheValue(store: KeyValueStore, key: string, value: string): boolean {",
      "  if (store instanceof ReadOnlyArchiveStore) {",
      "    return false;",
      "  }",
      "  store.set(key, value);",
      "  return true;",
      "}"
    ]
  },
  "expect": {
    "liskov_substitution": "fail"
  }
}
