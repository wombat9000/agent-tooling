{
  "id": "comment-deodorant-dead-code-good",
  "description": "Self-explanatory token bucket rate limiter with one concise rationale comment on a non-obvious clock-skew guard and zero dead code",
  "rubric": "fowler-smells",
  "files": {
    "token-bucket.ts": [
      "export interface BucketState {",
      "  readonly tokens: number;",
      "  readonly lastRefillMs: number;",
      "}",
      "",
      "export interface BucketConfig {",
      "  readonly capacity: number;",
      "  readonly refillPerSecond: number;",
      "}",
      "",
      "export function refillBucket(state: BucketState, config: BucketConfig, nowMs: number): BucketState {",
      "  // Clamp negative elapsed time when wall clocks step backward across NTP adjustments.",
      "  const elapsedMs = Math.max(0, nowMs - state.lastRefillMs);",
      "  const addedTokens = (elapsedMs / 1_000) * config.refillPerSecond;",
      "  return {",
      "    tokens: Math.min(config.capacity, state.tokens + addedTokens),",
      "    lastRefillMs: Math.max(state.lastRefillMs, nowMs),",
      "  };",
      "}"
    ],
    "rate-limiter.ts": [
      "import { refillBucket, type BucketConfig, type BucketState } from './token-bucket';",
      "",
      "export function tryConsumeToken(",
      "  state: BucketState,",
      "  config: BucketConfig,",
      "  nowMs: number,",
      "): { readonly allowed: boolean; readonly nextState: BucketState } {",
      "  const refilled = refillBucket(state, config, nowMs);",
      "  if (refilled.tokens < 1) {",
      "    return { allowed: false, nextState: refilled };",
      "  }",
      "  return {",
      "    allowed: true,",
      "    nextState: { tokens: refilled.tokens - 1, lastRefillMs: refilled.lastRefillMs },",
      "  };",
      "}"
    ]
  },
  "expect": {
    "no_comment_deodorant_or_dead_code": "pass"
  }
}
