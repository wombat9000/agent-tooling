{
  "id": "single-responsibility-small-helper-good",
  "description": "Small focused usage-accounting helper module with pricing metadata constant, event aggregation function, and input rate parser",
  "rubric": "solid",
  "files": {
    "usage-accounting.ts": [
      "export interface RateCard {",
      "  readonly inputUsdPerMillion: number;",
      "  readonly outputUsdPerMillion: number;",
      "}",
      "",
      "export interface UsageEvent {",
      "  readonly tier: keyof typeof DEFAULT_RATE_CARDS;",
      "  readonly inputUnits: number;",
      "  readonly outputUnits: number;",
      "}",
      "",
      "export interface UsageTotals {",
      "  readonly eventCount: number;",
      "  readonly totalInputUnits: number;",
      "  readonly totalOutputUnits: number;",
      "  readonly estimatedCostUsd: number;",
      "}",
      "",
      "export const DEFAULT_RATE_CARDS = {",
      "  standard: { inputUsdPerMillion: 0.4, outputUsdPerMillion: 1.6 },",
      "  priority: { inputUsdPerMillion: 1.5, outputUsdPerMillion: 6.0 },",
      "} as const satisfies Record<string, RateCard>;",
      "",
      "export function parseRatePerMillion(raw: string): number {",
      "  const value = Number(raw.trim());",
      "  if (!Number.isFinite(value) || value < 0) {",
      "    throw new Error(`Invalid unit rate: ${raw}`);",
      "  }",
      "  return value;",
      "}",
      "",
      "export function aggregateUsageEvents(",
      "  events: readonly UsageEvent[],",
      "  rates: Record<keyof typeof DEFAULT_RATE_CARDS, RateCard> = DEFAULT_RATE_CARDS,",
      "): UsageTotals {",
      "  let totalInputUnits = 0;",
      "  let totalOutputUnits = 0;",
      "  let costUsd = 0;",
      "",
      "  for (const event of events) {",
      "    const card = rates[event.tier];",
      "    totalInputUnits += event.inputUnits;",
      "    totalOutputUnits += event.outputUnits;",
      "    costUsd += (event.inputUnits / 1_000_000) * card.inputUsdPerMillion;",
      "    costUsd += (event.outputUnits / 1_000_000) * card.outputUsdPerMillion;",
      "  }",
      "",
      "  return {",
      "    eventCount: events.length,",
      "    totalInputUnits,",
      "    totalOutputUnits,",
      "    estimatedCostUsd: Number(costUsd.toFixed(6)),",
      "  };",
      "}"
    ]
  },
  "expect": {
    "single_responsibility": "pass"
  }
}
