{
  "id": "immutable-state-kotlin-bad",
  "description": "Kotlin domain class mutating caller-shared state in place, exposing mutable collections, and sharing mutable companion state across calls",
  "rubric": "domain-modelling",
  "files": {
    "OrderLedger.kt": [
      "package com.acme.warehouse",
      "",
      "class OrderItem(val sku: String, var quantity: Int)",
      "",
      "class OrderBook(val id: String) {",
      "    var status: String = \"OPEN\"",
      "    val items: MutableList<OrderItem> = mutableListOf()",
      "",
      "    fun addOrIncrement(sku: String, qty: Int) {",
      "        val existing = items.firstOrNull { it.sku == sku }",
      "        if (existing != null) {",
      "            existing.quantity += qty",
      "        } else {",
      "            items.add(OrderItem(sku, qty))",
      "        }",
      "        globalHistory.add(this)",
      "    }",
      "",
      "    fun close() {",
      "        status = \"CLOSED\"",
      "    }",
      "",
      "    companion object {",
      "        val globalHistory: MutableList<OrderBook> = mutableListOf()",
      "    }",
      "}"
    ]
  },
  "expect": {
    "immutable_state": "fail"
  }
}
