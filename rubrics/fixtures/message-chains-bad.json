{
  "id": "message-chains-bad",
  "description": "Repeatedly navigates deep object-graph getter chains across multiple nested domain objects",
  "rubric": "fowler-smells",
  "files": {
    "types.ts": [
      "export interface TaxRule { getRate(): number; getRegionCode(): string; }",
      "export interface Country { getCode(): string; getTaxRule(): TaxRule; }",
      "export interface Address { getCountry(): Country; getPostalCode(): string; }",
      "export interface BillingProfile { getPrimaryAddress(): Address; getCurrencyCode(): string; }",
      "export interface Account { getBillingProfile(): BillingProfile; }",
      "export interface Customer { getAccount(): Account; }",
      "export interface Order { getId(): string; getCustomer(): Customer; getSubtotalCents(): number; }"
    ],
    "fulfillment.ts": [
      "import type { Order } from './types';",
      "",
      "export function buildTaxInvoiceSummary(order: Order) {",
      "  const countryCode = order.getCustomer().getAccount().getBillingProfile().getPrimaryAddress().getCountry().getCode();",
      "  const postalCode = order.getCustomer().getAccount().getBillingProfile().getPrimaryAddress().getPostalCode();",
      "  const taxRate = order.getCustomer().getAccount().getBillingProfile().getPrimaryAddress().getCountry().getTaxRule().getRate();",
      "  const regionCode = order.getCustomer().getAccount().getBillingProfile().getPrimaryAddress().getCountry().getTaxRule().getRegionCode();",
      "  const currency = order.getCustomer().getAccount().getBillingProfile().getCurrencyCode();",
      "  const taxCents = Math.round(order.getSubtotalCents() * taxRate);",
      "",
      "  return {",
      "    orderId: order.getId(),",
      "    countryCode,",
      "    postalCode,",
      "    regionCode,",
      "    currency,",
      "    taxCents,",
      "  };",
      "}"
    ]
  },
  "expect": {
    "no_message_chains": "fail"
  }
}
