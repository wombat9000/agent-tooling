{
  "id": "repeated-switches-ui-presentation-good",
  "description": "Single-board React view rendering fixed stage columns and presentation badges locally while delegating card actions to callbacks",
  "rubric": "fowler-smells",
  "files": {
    "work-board-view.tsx": [
      "export type BoardStage = 'queued' | 'in_progress' | 'done';",
      "",
      "export interface BoardCard {",
      "  readonly id: string;",
      "  readonly title: string;",
      "  readonly stage: BoardStage;",
      "  readonly assigneeName: string | null;",
      "}",
      "",
      "export interface WorkBoardViewProps {",
      "  readonly cards: readonly BoardCard[];",
      "  readonly onSelectCard: (cardId: string) => void;",
      "  readonly onAdvanceCard: (cardId: string) => void;",
      "}",
      "",
      "const BOARD_COLUMNS: readonly { readonly stage: BoardStage; readonly heading: string; readonly emptyCopy: string }[] = [",
      "  { stage: 'queued', heading: 'Queued', emptyCopy: 'No queued items.' },",
      "  { stage: 'in_progress', heading: 'In Progress', emptyCopy: 'Nothing in flight.' },",
      "  { stage: 'done', heading: 'Done', emptyCopy: 'No completed items yet.' },",
      "];",
      "",
      "function renderStageBadge(stage: BoardStage) {",
      "  switch (stage) {",
      "    case 'queued':",
      "      return <span className=\"badge badge-neutral\">Queued</span>;",
      "    case 'in_progress':",
      "      return <span className=\"badge badge-active\">Active</span>;",
      "    case 'done':",
      "      return <span className=\"badge badge-success\">Complete</span>;",
      "  }",
      "}",
      "",
      "export function WorkBoardView({ cards, onSelectCard, onAdvanceCard }: WorkBoardViewProps) {",
      "  return (",
      "    <div className=\"work-board\">",
      "      {BOARD_COLUMNS.map((column) => {",
      "        const columnCards = cards.filter((card) => card.stage === column.stage);",
      "        return (",
      "          <section key={column.stage} className=\"board-column\">",
      "            <header className=\"board-column-header\">",
      "              <h2>{column.heading}</h2>",
      "              <span>{columnCards.length}</span>",
      "            </header>",
      "            {columnCards.length === 0 ? (",
      "              <p className=\"board-empty\">{column.emptyCopy}</p>",
      "            ) : (",
      "              <ul className=\"board-list\">",
      "                {columnCards.map((card) => (",
      "                  <li key={card.id} className=\"board-card\">",
      "                    <button type=\"button\" className=\"card-title\" onClick={() => onSelectCard(card.id)}>",
      "                      {card.title}",
      "                    </button>",
      "                    <div className=\"card-meta\">",
      "                      {renderStageBadge(card.stage)}",
      "                      <span>{card.assigneeName ?? 'Unassigned'}</span>",
      "                    </div>",
      "                    {card.stage !== 'done' && (",
      "                      <button type=\"button\" className=\"card-advance\" onClick={() => onAdvanceCard(card.id)}>",
      "                        Advance",
      "                      </button>",
      "                    )}",
      "                  </li>",
      "                ))}",
      "              </ul>",
      "            )}",
      "          </section>",
      "        );",
      "      })}",
      "    </div>",
      "  );",
      "}"
    ]
  },
  "expect": {
    "no_repeated_switches": "pass"
  }
}
