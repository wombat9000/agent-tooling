{
  "id": "unnecessary-abstraction-bad",
  "description": "Introduces a speculative single-implementation formatter interface, a one-branch factory, and a pass-through facade for a one-line string format",
  "rubric": "module-design",
  "files": {
    "i-alert-formatter.ts": [
      "export interface SystemAlert {",
      "  readonly id: string;",
      "  readonly severity: 'info' | 'warning' | 'critical';",
      "  readonly summary: string;",
      "}",
      "",
      "export interface IAlertFormatterStrategy {",
      "  format(alert: SystemAlert): string;",
      "}"
    ],
    "default-alert-formatter.ts": [
      "import type { IAlertFormatterStrategy, SystemAlert } from './i-alert-formatter';",
      "",
      "export class DefaultAlertFormatterStrategy implements IAlertFormatterStrategy {",
      "  format(alert: SystemAlert): string {",
      "    return `[${alert.severity.toUpperCase()}] ${alert.id}: ${alert.summary}`;",
      "  }",
      "}"
    ],
    "alert-formatter-factory.ts": [
      "import { DefaultAlertFormatterStrategy } from './default-alert-formatter';",
      "import type { IAlertFormatterStrategy } from './i-alert-formatter';",
      "",
      "export type FormatterStrategyType = 'default';",
      "",
      "export class AlertFormatterFactory {",
      "  static create(type: FormatterStrategyType = 'default'): IAlertFormatterStrategy {",
      "    if (type === 'default') {",
      "      return new DefaultAlertFormatterStrategy();",
      "    }",
      "    throw new Error(`Unknown formatter strategy: ${String(type)}`);",
      "  }",
      "}"
    ],
    "alert-formatter-facade.ts": [
      "import { AlertFormatterFactory } from './alert-formatter-factory';",
      "import type { IAlertFormatterStrategy, SystemAlert } from './i-alert-formatter';",
      "",
      "export class AlertFormatterFacade {",
      "  private readonly strategy: IAlertFormatterStrategy;",
      "",
      "  constructor(strategy: IAlertFormatterStrategy = AlertFormatterFactory.create('default')) {",
      "    this.strategy = strategy;",
      "  }",
      "",
      "  formatAlert(alert: SystemAlert): string {",
      "    return this.strategy.format(alert);",
      "  }",
      "}"
    ]
  },
  "expect": {
    "no_unnecessary_abstraction": "fail"
  }
}
