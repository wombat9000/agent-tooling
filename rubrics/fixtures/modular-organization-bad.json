{
  "id": "modular-organization-bad",
  "description": "Dumps domain models, HTTP request parsing, SQL persistence, HTML email rendering, CSV export, and monolithic workflow orchestration into one tangled file",
  "rubric": "module-design",
  "files": {
    "booking-all.ts": [
      "export interface RoomBooking { id: string; roomCode: string; startHour: number; endHour: number; guestEmail: string; }",
      "export interface RoomDirectoryEntry { roomCode: string; floor: number; capacity: number; }",
      "export interface AuditLogRow { bookingId: string; event: string; createdAtIso: string; }",
      "",
      "export class SqlBookingStore {",
      "  private readonly rows: RoomBooking[] = [];",
      "  private readonly auditRows: AuditLogRow[] = [];",
      "  listForRoom(roomCode: string): RoomBooking[] { return this.rows.filter((r) => r.roomCode === roomCode); }",
      "  insert(booking: RoomBooking): void { this.rows.push(booking); }",
      "  appendAudit(row: AuditLogRow): void { this.auditRows.push(row); }",
      "  exportCsv(): string {",
      "    return ['id,room,start,end,email', ...this.rows.map((r) => `${r.id},${r.roomCode},${r.startHour},${r.endHour},${r.guestEmail}`)].join('\\n');",
      "  }",
      "}",
      "",
      "export class ConfirmationEmailRenderer {",
      "  renderHtml(booking: RoomBooking, room: RoomDirectoryEntry): string {",
      "    return `<div><h1>Confirmed ${booking.roomCode}</h1><p>Floor ${room.floor}, ${booking.startHour}:00-${booking.endHour}:00</p></div>`;",
      "  }",
      "}",
      "",
      "export class BookingHttpController {",
      "  private readonly store = new SqlBookingStore();",
      "  private readonly renderer = new ConfirmationEmailRenderer();",
      "  private readonly rooms: readonly RoomDirectoryEntry[];",
      "",
      "  constructor(rooms: readonly RoomDirectoryEntry[]) {",
      "    this.rooms = rooms;",
      "  }",
      "",
      "  handleRequest(rawJson: string, id: string, nowIso: string): { status: number; body: string; emailHtml?: string } {",
      "    let parsed: Record<string, unknown>;",
      "    try { parsed = JSON.parse(rawJson) as Record<string, unknown>; } catch { return { status: 400, body: 'Invalid JSON' }; }",
      "    const roomCode = typeof parsed.roomCode === 'string' ? parsed.roomCode.trim() : '';",
      "    const guestEmail = typeof parsed.guestEmail === 'string' ? parsed.guestEmail.trim() : '';",
      "    const startHour = Number(parsed.startHour);",
      "    const endHour = Number(parsed.endHour);",
      "    const room = this.rooms.find((r) => r.roomCode === roomCode);",
      "    if (!room || !guestEmail.includes('@') || !Number.isInteger(startHour) || !Number.isInteger(endHour) || endHour <= startHour) {",
      "      return { status: 400, body: 'Invalid booking input' };",
      "    }",
      "    const existing = this.store.listForRoom(roomCode);",
      "    for (const item of existing) {",
      "      if (item.startHour < endHour && startHour < item.endHour) {",
      "        return { status: 409, body: 'Time slot conflict' };",
      "      }",
      "    }",
      "    const booking: RoomBooking = { id, roomCode, startHour, endHour, guestEmail };",
      "    this.store.insert(booking);",
      "    this.store.appendAudit({ bookingId: id, event: 'created', createdAtIso: nowIso });",
      "    return { status: 201, body: JSON.stringify(booking), emailHtml: this.renderer.renderHtml(booking, room) };",
      "  }",
      "}"
    ],
    "index.ts": [
      "export { BookingHttpController, ConfirmationEmailRenderer, SqlBookingStore } from './booking-all';"
    ]
  },
  "expect": {
    "modular_organization": "fail"
  }
}
