{
  "id": "named-domain-expressions-bad",
  "description": "Embeds dense unnamed multi-clause arithmetic, regex, and state conditions directly inside guards and nested ternaries",
  "mode": "file",
  "rubric": "readability",
  "files": {
    "refund-policy.ts": [
      "export interface RefundRequest {",
      "  readonly status: string;",
      "  readonly daysSinceDelivery: number;",
      "  readonly amountCents: number;",
      "  readonly customerIsMember: boolean;",
      "  readonly openedPackaging: boolean;",
      "  readonly receiptCode: string;",
      "  readonly priorRefundsLast90Days: number;",
      "}",
      "",
      "export function decideRefund(r: RefundRequest): 'approved' | 'manual_review' | 'rejected' {",
      "  if (",
      "    r.status !== 'delivered' ||",
      "    (r.customerIsMember ? r.daysSinceDelivery > 30 : r.daysSinceDelivery > 14) ||",
      "    !/^[A-Z]{2}-\\d{6}-[1-9]$/.test(r.receiptCode) ||",
      "    (r.priorRefundsLast90Days >= 3 && r.amountCents > 2500)",
      "  ) {",
      "    return 'rejected';",
      "  }",
      "  return !r.openedPackaging && r.amountCents <= 5000 && (r.customerIsMember || r.priorRefundsLast90Days === 0)",
      "    ? 'approved'",
      "    : r.amountCents > 25000 && !r.customerIsMember && r.daysSinceDelivery > 7",
      "      ? 'rejected'",
      "      : 'manual_review';",
      "}"
    ]
  },
  "expect": {
    "named_domain_expressions": "fail"
  }
}
