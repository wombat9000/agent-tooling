{
  "id": "workaround-proxies-good",
  "description": "BFF proxy verifies the session once per request and forwards cleanly to the upstream HTTP API without stub round-tripping or parity scaffolding",
  "rubric": "integration-readiness",
  "files": {
    "auth.ts": [
      "export interface VerifiedSession {",
      "  readonly userId: string;",
      "  readonly accessToken: string;",
      "}",
      "",
      "export interface SessionVerifier {",
      "  verifyCookie(cookieHeader: string | null): Promise<VerifiedSession | null>;",
      "}"
    ],
    "upstream-client.ts": [
      "export async function forwardGet(",
      "  baseUrl: string,",
      "  path: string,",
      "  accessToken: string,",
      "): Promise<{ readonly status: number; readonly body: string }> {",
      "  const response = await fetch(`${baseUrl}${path}`, {",
      "    headers: { Authorization: `Bearer ${accessToken}`, Accept: 'application/json' },",
      "  });",
      "  return { status: response.status, body: await response.text() };",
      "}"
    ],
    "orders-proxy-route.ts": [
      "import type { SessionVerifier } from './auth';",
      "import { forwardGet } from './upstream-client';",
      "",
      "export async function handleGetOrderProxy(",
      "  verifier: SessionVerifier,",
      "  baseUrl: string,",
      "  cookieHeader: string | null,",
      "  orderId: string,",
      ") {",
      "  const session = await verifier.verifyCookie(cookieHeader);",
      "  if (!session) {",
      "    return { status: 401, body: JSON.stringify({ error: 'Unauthorized' }) };",
      "  }",
      "  return forwardGet(baseUrl, `/api/orders/${encodeURIComponent(orderId)}`, session.accessToken);",
      "}"
    ]
  },
  "expect": {
    "no_workaround_proxies_or_parity_tax": "pass"
  }
}
