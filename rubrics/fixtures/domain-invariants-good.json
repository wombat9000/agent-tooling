{
  "id": "domain-invariants-good",
  "description": "Domain types and validated constructors enforce reservation date range, guest count, and state transition invariants directly on the owning types",
  "rubric": "domain-modelling",
  "files": {
    "date-range.ts": [
      "export class StayPeriod {",
      "  readonly checkInDate: string;",
      "  readonly checkOutDate: string;",
      "  readonly nights: number;",
      "",
      "  private constructor(checkInDate: string, checkOutDate: string, nights: number) {",
      "    this.checkInDate = checkInDate;",
      "    this.checkOutDate = checkOutDate;",
      "    this.nights = nights;",
      "  }",
      "",
      "  static create(checkInDate: string, checkOutDate: string): StayPeriod {",
      "    const startMs = Date.parse(checkInDate);",
      "    const endMs = Date.parse(checkOutDate);",
      "    if (!Number.isFinite(startMs) || !Number.isFinite(endMs) || endMs <= startMs) {",
      "      throw new Error('Check-out date must be after check-in date');",
      "    }",
      "    const nights = Math.round((endMs - startMs) / 86_400_000);",
      "    if (nights < 1 || nights > 30) {",
      "      throw new Error('Stay length must be between 1 and 30 nights');",
      "    }",
      "    return new StayPeriod(checkInDate, checkOutDate, nights);",
      "  }",
      "}"
    ],
    "reservation.ts": [
      "import { StayPeriod } from './date-range';",
      "",
      "export type ReservationStatus = 'confirmed' | 'cancelled';",
      "",
      "export class Reservation {",
      "  readonly id: string;",
      "  readonly stay: StayPeriod;",
      "  readonly guestCount: number;",
      "  readonly status: ReservationStatus;",
      "",
      "  private constructor(id: string, stay: StayPeriod, guestCount: number, status: ReservationStatus) {",
      "    this.id = id;",
      "    this.stay = stay;",
      "    this.guestCount = guestCount;",
      "    this.status = status;",
      "  }",
      "",
      "  static book(id: string, stay: StayPeriod, guestCount: number): Reservation {",
      "    if (!Number.isInteger(guestCount) || guestCount < 1 || guestCount > 6) {",
      "      throw new Error('Guest count must be an integer between 1 and 6');",
      "    }",
      "    return new Reservation(id, stay, guestCount, 'confirmed');",
      "  }",
      "",
      "  cancel(): Reservation {",
      "    if (this.status === 'cancelled') {",
      "      throw new Error('Reservation is already cancelled');",
      "    }",
      "    return new Reservation(this.id, this.stay, this.guestCount, 'cancelled');",
      "  }",
      "}"
    ],
    "reservation-service.ts": [
      "import { StayPeriod } from './date-range';",
      "import { Reservation } from './reservation';",
      "",
      "export interface ReservationRepository {",
      "  save(reservation: Reservation): Promise<void>;",
      "}",
      "",
      "export async function createReservation(",
      "  repository: ReservationRepository,",
      "  input: { readonly id: string; readonly checkIn: string; readonly checkOut: string; readonly guests: number },",
      "): Promise<Reservation> {",
      "  const stay = StayPeriod.create(input.checkIn, input.checkOut);",
      "  const reservation = Reservation.book(input.id, stay, input.guests);",
      "  await repository.save(reservation);",
      "  return reservation;",
      "}"
    ]
  },
  "expect": {
    "domain_invariants": "pass"
  }
}
