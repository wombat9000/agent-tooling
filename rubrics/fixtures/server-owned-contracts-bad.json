{
  "id": "server-owned-contracts-bad",
  "description": "BFF proxy duplicates backend field validation and enum whitelists, fills domain defaults, and parses prefixed sequential template IDs",
  "rubric": "api-design",
  "files": {
    "template-validator.ts": [
      "// Validating payloads in the BFF keeps malformed writes off the upstream wire.",
      "const ALLOWED_CHANNELS = new Set(['email', 'sms', 'push']);",
      "const TEMPLATE_ID_PATTERN = /^emtpl_\\d{2,6}$/;",
      "",
      "export function validateAndFillTemplatePayload(raw: Record<string, unknown>) {",
      "  const name = typeof raw.name === 'string' ? raw.name.trim() : '';",
      "  if (name.length < 3 || name.length > 120) {",
      "    throw new Error('Template name must be between 3 and 120 characters');",
      "  }",
      "  const channel = typeof raw.channel === 'string' ? raw.channel : 'email';",
      "  if (!ALLOWED_CHANNELS.has(channel)) {",
      "    throw new Error(`Invalid channel: ${channel}`);",
      "  }",
      "  return {",
      "    name,",
      "    channel,",
      "    category: typeof raw.category === 'string' ? raw.category : 'general',",
      "    targetSubstages: Array.isArray(raw.targetSubstages) ? raw.targetSubstages : [],",
      "    priority: typeof raw.priority === 'number' ? raw.priority : 2,",
      "  };",
      "}",
      "",
      "export function isValidBackendTemplateId(id: string): boolean {",
      "  return TEMPLATE_ID_PATTERN.test(id);",
      "}",
      "",
      "export function isDemoTemplateId(id: string): boolean {",
      "  return id.startsWith('demo_emtpl_');",
      "}"
    ],
    "upstream-client.ts": [
      "export async function sendUpstreamPatch(baseUrl: string, id: string, authHeader: string, payload: unknown) {",
      "  const response = await fetch(`${baseUrl}/api/templates/${id}`, {",
      "    method: 'PATCH',",
      "    headers: { Authorization: authHeader, 'Content-Type': 'application/json' },",
      "    body: JSON.stringify(payload),",
      "  });",
      "  return { status: response.status, body: await response.text() };",
      "}"
    ],
    "bff-template-route.ts": [
      "import { isDemoTemplateId, isValidBackendTemplateId, validateAndFillTemplatePayload } from './template-validator';",
      "import { sendUpstreamPatch } from './upstream-client';",
      "",
      "export async function handlePatchTemplateProxy(",
      "  baseUrl: string,",
      "  authHeader: string | null,",
      "  templateId: string,",
      "  rawBody: Record<string, unknown>,",
      ") {",
      "  if (!authHeader) return { status: 401, body: 'Unauthorized' };",
      "  if (isDemoTemplateId(templateId) || !isValidBackendTemplateId(templateId)) {",
      "    return { status: 400, body: 'Invalid template ID prefix' };",
      "  }",
      "  const normalized = validateAndFillTemplatePayload(rawBody);",
      "  return sendUpstreamPatch(baseUrl, templateId, authHeader, normalized);",
      "}"
    ]
  },
  "expect": {
    "clean_server_owned_contracts_and_opaque_ids": "fail"
  }
}
