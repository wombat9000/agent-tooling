{
  "id": "feature-flag-isolation-good",
  "description": "Defines analytics v2 feature flag once with consistent fail-closed semantics across page and data routes and separate versioned persisted table keys",
  "rubric": "integration-readiness",
  "files": {
    "feature-flags.ts": [
      "export const ANALYTICS_V2_FLAG = 'ENABLE_ANALYTICS_V2' as const;",
      "",
      "export function isAnalyticsV2Enabled(env: Readonly<Record<string, string | undefined>>): boolean {",
      "  return env[ANALYTICS_V2_FLAG]?.trim().toLowerCase() === 'true';",
      "}",
      "",
      "export function reportsTableStorageKey(analyticsV2Enabled: boolean): string {",
      "  return analyticsV2Enabled ? 'reports-table-prefs-v2' : 'reports-table-prefs-v1';",
      "}"
    ],
    "reports-page.ts": [
      "import { isAnalyticsV2Enabled, reportsTableStorageKey } from './feature-flags';",
      "",
      "export function buildReportsPageProps(env: Readonly<Record<string, string | undefined>>) {",
      "  const analyticsV2 = isAnalyticsV2Enabled(env);",
      "  return {",
      "    analyticsV2,",
      "    tableStorageKey: reportsTableStorageKey(analyticsV2),",
      "  };",
      "}"
    ],
    "reports-data-route.ts": [
      "import { isAnalyticsV2Enabled } from './feature-flags';",
      "",
      "export function handleAnalyticsV2Data(env: Readonly<Record<string, string | undefined>>) {",
      "  if (!isAnalyticsV2Enabled(env)) {",
      "    return { status: 404, body: { error: 'Not found' } };",
      "  }",
      "  return { status: 200, body: { cohortMetrics: [] } };",
      "}"
    ]
  },
  "expect": {
    "consistent_feature_flag_isolation": "pass"
  }
}
