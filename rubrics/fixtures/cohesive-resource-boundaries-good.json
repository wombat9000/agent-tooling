{
  "id": "cohesive-resource-boundaries-good",
  "description": "Message template API DTOs, service, and routes stay focused on template resource fields without cross-domain picker hooks or unbuilt placeholder sub-features",
  "rubric": "api-design",
  "files": {
    "template-types.ts": [
      "export interface MessageTemplateDto {",
      "  readonly id: string;",
      "  readonly name: string;",
      "  readonly subject: string;",
      "  readonly bodyMarkdown: string;",
      "  readonly folderLabel: string | null;",
      "  readonly updatedAtIso: string;",
      "}",
      "",
      "export interface CreateMessageTemplateInput {",
      "  readonly name: string;",
      "  readonly subject: string;",
      "  readonly bodyMarkdown: string;",
      "  readonly folderLabel?: string | null;",
      "}"
    ],
    "template-service.ts": [
      "import type { CreateMessageTemplateInput, MessageTemplateDto } from './template-types';",
      "",
      "export interface TemplateStore {",
      "  list(): Promise<readonly MessageTemplateDto[]>;",
      "  insert(input: CreateMessageTemplateInput): Promise<MessageTemplateDto>;",
      "}",
      "",
      "export class MessageTemplateService {",
      "  private readonly store: TemplateStore;",
      "",
      "  constructor(store: TemplateStore) {",
      "    this.store = store;",
      "  }",
      "",
      "  listTemplates(): Promise<readonly MessageTemplateDto[]> {",
      "    return this.store.list();",
      "  }",
      "",
      "  createTemplate(input: CreateMessageTemplateInput): Promise<MessageTemplateDto> {",
      "    return this.store.insert(input);",
      "  }",
      "}"
    ],
    "template-routes.ts": [
      "import type { MessageTemplateService } from './template-service';",
      "import type { CreateMessageTemplateInput } from './template-types';",
      "",
      "export async function handleListTemplates(service: MessageTemplateService) {",
      "  const items = await service.listTemplates();",
      "  return { status: 200, body: { items } };",
      "}",
      "",
      "export async function handleCreateTemplate(",
      "  service: MessageTemplateService,",
      "  payload: CreateMessageTemplateInput,",
      ") {",
      "  const created = await service.createTemplate(payload);",
      "  return { status: 201, body: created };",
      "}"
    ]
  },
  "expect": {
    "cohesive_resource_boundaries": "pass"
  }
}
