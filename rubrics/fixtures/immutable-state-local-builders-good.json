{
  "id": "immutable-state-local-builders-good",
  "description": "Preserves caller-owned snapshots across domain transitions while using unescaped local accumulators, an async coordination ref, and a scoped infrastructure cache",
  "rubric": "domain-modelling",
  "files": {
    "catalog-index.ts": [
      "export interface CatalogEntry {",
      "  sku: string;",
      "  category: string;",
      "  priceCents: number;",
      "}",
      "",
      "export interface CategorySummary {",
      "  category: string;",
      "  itemCount: number;",
      "  totalPriceCents: number;",
      "}",
      "",
      "export function summarizeByCategory(entries: CatalogEntry[]): CategorySummary[] {",
      "  const totals = new Map<string, { itemCount: number; totalPriceCents: number }>();",
      "  for (const entry of entries) {",
      "    const current = totals.get(entry.category);",
      "    if (current) {",
      "      current.itemCount += 1;",
      "      current.totalPriceCents += entry.priceCents;",
      "    } else {",
      "      totals.set(entry.category, { itemCount: 1, totalPriceCents: entry.priceCents });",
      "    }",
      "  }",
      "  const result: CategorySummary[] = [];",
      "  for (const [category, stats] of totals.entries()) {",
      "    result.push({ category, itemCount: stats.itemCount, totalPriceCents: stats.totalPriceCents });",
      "  }",
      "  return result.sort((a, b) => a.category.localeCompare(b.category));",
      "}",
      "",
      "export function applyPriceAdjustment(entry: CatalogEntry, deltaCents: number): CatalogEntry {",
      "  return { ...entry, priceCents: Math.max(0, entry.priceCents + deltaCents) };",
      "}",
      "",
      "export class CatalogLookupClient {",
      "  private readonly cache = new Map<string, { value: CatalogEntry; expiresAt: number }>();",
      "  private inFlightController: AbortController | null = null;",
      "",
      "  constructor(private readonly fetchEntry: (sku: string, signal: AbortSignal) => Promise<CatalogEntry>) {}",
      "",
      "  async lookup(sku: string, nowMs: number = Date.now()): Promise<CatalogEntry> {",
      "    const cached = this.cache.get(sku);",
      "    if (cached && cached.expiresAt > nowMs) {",
      "      return { ...cached.value };",
      "    }",
      "    this.inFlightController?.abort();",
      "    const controller = new AbortController();",
      "    this.inFlightController = controller;",
      "    const loaded = await this.fetchEntry(sku, controller.signal);",
      "    this.cache.set(sku, { value: { ...loaded }, expiresAt: nowMs + 30_000 });",
      "    return { ...loaded };",
      "  }",
      "}"
    ]
  },
  "expect": {
    "immutable_state": "pass"
  }
}
