{
  "id": "parameter-lists-data-clumps-good",
  "description": "Accepts a single cohesive destructured options/props record (1 formal parameter) and calls an imported wide legacy function from a concise declared caller",
  "mode": "file",
  "rubric": "fowler-smells",
  "files": {
    "billing-summary.ts": [
      "import { dispatchLegacyAuditEvent } from './legacy-audit-client';",
      "",
      "export interface BillingSummaryProps {",
      "  readonly customerName: string;",
      "  readonly planName: string;",
      "  readonly billingCycle: 'monthly' | 'annual';",
      "  readonly seatCount: number;",
      "  readonly ratePerSeatCents: number;",
      "  readonly currencyCode: string;",
      "  readonly nextRenewalDate: string;",
      "  readonly taxExempt: boolean;",
      "  readonly onRequestUpgrade: () => void;",
      "}",
      "",
      "export function formatBillingBanner({",
      "  customerName,",
      "  planName,",
      "  billingCycle,",
      "  seatCount,",
      "  ratePerSeatCents,",
      "  currencyCode,",
      "  nextRenewalDate,",
      "  taxExempt,",
      "}: BillingSummaryProps): string {",
      "  const total = ((seatCount * ratePerSeatCents) / 100).toFixed(2);",
      "  const taxNote = taxExempt ? 'tax-exempt' : 'plus applicable tax';",
      "  return `${customerName} — ${planName} (${billingCycle}): ${currencyCode} ${total} (${taxNote}), renews ${nextRenewalDate}`;",
      "}",
      "",
      "export function recordUpgradeClick(accountId: string, actorEmail: string): void {",
      "  dispatchLegacyAuditEvent(",
      "    accountId,",
      "    actorEmail,",
      "    'billing.upgrade_requested',",
      "    'web',",
      "    true,",
      "    0,",
      "    null,",
      "    'v2',",
      "  );",
      "}"
    ]
  },
  "expect": {
    "no_long_parameter_lists_or_data_clumps": "pass"
  }
}
