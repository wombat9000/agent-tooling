{
  "id": "shadow-screen-forks-bad",
  "description": "Duplicates the entire orders screen, column definitions, and filter logic into a parallel phase1/ shadow fork switched at runtime",
  "rubric": "integration-readiness",
  "files": {
    "phase1/orders-columns.ts": [
      "export interface LegacyTableColumn {",
      "  readonly key: string;",
      "  readonly label: string;",
      "}",
      "",
      "export const PHASE1_ORDER_COLUMNS: readonly LegacyTableColumn[] = [",
      "  { key: 'orderNumber', label: 'Order' },",
      "  { key: 'customer', label: 'Customer' },",
      "  { key: 'total', label: 'Total' },",
      "];"
    ],
    "phase1/orders-screen.ts": [
      "import { PHASE1_ORDER_COLUMNS } from './orders-columns';",
      "",
      "export interface Phase1OrderRow {",
      "  readonly orderNumber: string;",
      "  readonly customer: string;",
      "  readonly totalCents: number;",
      "}",
      "",
      "export function buildPhase1OrdersViewModel(rows: readonly Phase1OrderRow[], query: string) {",
      "  const term = query.trim().toLowerCase();",
      "  return {",
      "    columns: PHASE1_ORDER_COLUMNS,",
      "    rows: rows.filter((row) => !term || row.customer.toLowerCase().includes(term) || row.orderNumber.toLowerCase().includes(term)),",
      "  };",
      "}"
    ],
    "orders-columns.ts": [
      "export interface ModernTableColumn {",
      "  readonly key: string;",
      "  readonly label: string;",
      "}",
      "",
      "export const V2_ORDER_COLUMNS: readonly ModernTableColumn[] = [",
      "  { key: 'orderNumber', label: 'Order' },",
      "  { key: 'customer', label: 'Customer' },",
      "  { key: 'total', label: 'Total' },",
      "  { key: 'fulfillmentStatus', label: 'Fulfillment' },",
      "];"
    ],
    "orders-screen.ts": [
      "import { V2_ORDER_COLUMNS } from './orders-columns';",
      "import { buildPhase1OrdersViewModel } from './phase1/orders-screen';",
      "",
      "export interface OrderRow {",
      "  readonly orderNumber: string;",
      "  readonly customer: string;",
      "  readonly totalCents: number;",
      "  readonly fulfillmentStatus?: 'queued' | 'shipped';",
      "}",
      "",
      "// ADR-14: Keep Phase 1 screen frozen in phase1/ while V2 rolls out.",
      "export function buildOrdersViewModel(rows: readonly OrderRow[], query: string, v2Enabled: boolean) {",
      "  if (!v2Enabled) {",
      "    return buildPhase1OrdersViewModel(rows, query);",
      "  }",
      "  const term = query.trim().toLowerCase();",
      "  return {",
      "    columns: V2_ORDER_COLUMNS,",
      "    rows: rows.filter((row) => !term || row.customer.toLowerCase().includes(term) || row.orderNumber.toLowerCase().includes(term)),",
      "  };",
      "}"
    ]
  },
  "expect": {
    "no_shadow_screen_forks": "fail"
  }
}
