{
  "id": "minimal-http-surface-good",
  "description": "Campaign API exposes standard REST resource endpoints with minimal proportional DTOs and standard Idempotency-Key / If-Match headers",
  "rubric": "api-design",
  "files": {
    "campaign-dto.ts": [
      "export type CampaignStatus = 'draft' | 'sent';",
      "",
      "export interface CampaignDto {",
      "  readonly id: string;",
      "  readonly name: string;",
      "  readonly subject: string;",
      "  readonly bodyMarkdown: string;",
      "  readonly status: CampaignStatus;",
      "  readonly version: number;",
      "}",
      "",
      "export interface UpdateCampaignRequest {",
      "  readonly name?: string;",
      "  readonly subject?: string;",
      "  readonly bodyMarkdown?: string;",
      "}"
    ],
    "campaign-service.ts": [
      "import type { CampaignDto, UpdateCampaignRequest } from './campaign-dto';",
      "",
      "export interface CampaignService {",
      "  getById(id: string): Promise<CampaignDto | null>;",
      "  update(id: string, patch: UpdateCampaignRequest, expectedVersion: number): Promise<CampaignDto>;",
      "  send(id: string, idempotencyKey: string): Promise<CampaignDto>;",
      "}"
    ],
    "campaign-routes.ts": [
      "import type { UpdateCampaignRequest } from './campaign-dto';",
      "import type { CampaignService } from './campaign-service';",
      "",
      "export async function handlePatchCampaign(",
      "  service: CampaignService,",
      "  id: string,",
      "  ifMatchVersion: number,",
      "  patch: UpdateCampaignRequest,",
      ") {",
      "  const updated = await service.update(id, patch, ifMatchVersion);",
      "  return { status: 200, headers: { ETag: `\"${updated.version}\"` }, body: updated };",
      "}",
      "",
      "export async function handleSendCampaign(",
      "  service: CampaignService,",
      "  id: string,",
      "  idempotencyKey: string,",
      ") {",
      "  const sent = await service.send(id, idempotencyKey);",
      "  return { status: 200, body: sent };",
      "}"
    ]
  },
  "expect": {
    "minimal_standard_http_surface": "pass"
  }
}
