{
  "id": "dependency-inversion-good",
  "description": "Trial domain policy and application service depend strictly on domain values and focused repository/clock/notifier ports rather than concrete fs, env, Date, or fetch APIs",
  "rubric": "solid",
  "files": {
    "trial-policy.ts": [
      "export interface TrialAccount {",
      "  readonly id: string;",
      "  readonly email: string;",
      "  readonly trialEndsAtMs: number;",
      "  readonly expired: boolean;",
      "}",
      "",
      "export function shouldExpireTrial(account: TrialAccount, nowMs: number): boolean {",
      "  return !account.expired && nowMs >= account.trialEndsAtMs;",
      "}"
    ],
    "ports.ts": [
      "import type { TrialAccount } from './trial-policy';",
      "",
      "export interface TrialRepository {",
      "  listActiveTrials(): Promise<readonly TrialAccount[]>;",
      "  markExpired(accountId: string): Promise<void>;",
      "}",
      "",
      "export interface TrialNotifier {",
      "  sendExpirationNotice(email: string, accountId: string): Promise<void>;",
      "}",
      "",
      "export interface Clock {",
      "  nowMs(): number;",
      "}"
    ],
    "trial-service.ts": [
      "import type { Clock, TrialNotifier, TrialRepository } from './ports';",
      "import { shouldExpireTrial } from './trial-policy';",
      "",
      "export class TrialExpirationService {",
      "  private readonly repository: TrialRepository;",
      "  private readonly notifier: TrialNotifier;",
      "  private readonly clock: Clock;",
      "",
      "  constructor(repository: TrialRepository, notifier: TrialNotifier, clock: Clock) {",
      "    this.repository = repository;",
      "    this.notifier = notifier;",
      "    this.clock = clock;",
      "  }",
      "",
      "  async expireDueTrials(): Promise<number> {",
      "    const nowMs = this.clock.nowMs();",
      "    const accounts = await this.repository.listActiveTrials();",
      "    let expiredCount = 0;",
      "    for (const account of accounts) {",
      "      if (!shouldExpireTrial(account, nowMs)) continue;",
      "      await this.repository.markExpired(account.id);",
      "      await this.notifier.sendExpirationNotice(account.email, account.id);",
      "      expiredCount += 1;",
      "    }",
      "    return expiredCount;",
      "  }",
      "}"
    ]
  },
  "expect": {
    "dependency_inversion": "pass"
  }
}
