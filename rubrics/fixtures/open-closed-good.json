{
  "id": "open-closed-good",
  "description": "Models an anonymized multi-phase approval workflow with a declarative phase definition registry so adding a phase requires one self-contained entry without editing engine conditionals",
  "rubric": "solid",
  "files": {
    "workflow-states.ts": [
      "export type WorkflowPhase = 'intake' | 'triage' | 'review' | 'approved' | 'closed';",
      "",
      "export interface CaseSnapshot {",
      "  readonly id: string;",
      "  readonly phase: WorkflowPhase;",
      "  readonly assignedOwnerId: string | null;",
      "  readonly approvalsReceived: number;",
      "  readonly summaryNotes: string;",
      "}",
      "",
      "export interface PhaseDefinition {",
      "  readonly nextPhase: WorkflowPhase | null;",
      "  readonly slaHours: number;",
      "  readonly canAdvance: (snapshot: CaseSnapshot) => boolean;",
      "  readonly statusBanner: (snapshot: CaseSnapshot) => string;",
      "}"
    ],
    "phase-registry.ts": [
      "import type { PhaseDefinition, WorkflowPhase } from './workflow-states';",
      "",
      "export const PHASE_DEFINITIONS: Record<WorkflowPhase, PhaseDefinition> = {",
      "  intake: {",
      "    nextPhase: 'triage',",
      "    slaHours: 4,",
      "    canAdvance: (c) => c.summaryNotes.trim().length > 0,",
      "    statusBanner: (c) => `Case ${c.id} awaiting initial intake details`,",
      "  },",
      "  triage: {",
      "    nextPhase: 'review',",
      "    slaHours: 12,",
      "    canAdvance: (c) => c.assignedOwnerId !== null,",
      "    statusBanner: (c) => `Case ${c.id} in triage`,",
      "  },",
      "  review: {",
      "    nextPhase: 'approved',",
      "    slaHours: 24,",
      "    canAdvance: (c) => c.approvalsReceived >= 2,",
      "    statusBanner: (c) => `Case ${c.id} needs ${Math.max(0, 2 - c.approvalsReceived)} more approval(s)`,",
      "  },",
      "  approved: {",
      "    nextPhase: 'closed',",
      "    slaHours: 48,",
      "    canAdvance: () => true,",
      "    statusBanner: (c) => `Case ${c.id} approved and ready to close`,",
      "  },",
      "  closed: {",
      "    nextPhase: null,",
      "    slaHours: 0,",
      "    canAdvance: () => false,",
      "    statusBanner: (c) => `Case ${c.id} closed`,",
      "  },",
      "};"
    ],
    "workflow-engine.ts": [
      "import { PHASE_DEFINITIONS } from './phase-registry';",
      "import type { CaseSnapshot } from './workflow-states';",
      "",
      "export function advanceCase(snapshot: CaseSnapshot): CaseSnapshot {",
      "  const definition = PHASE_DEFINITIONS[snapshot.phase];",
      "  if (!definition.nextPhase || !definition.canAdvance(snapshot)) {",
      "    throw new Error(`Case ${snapshot.id} cannot advance from ${snapshot.phase}`);",
      "  }",
      "  return { ...snapshot, phase: definition.nextPhase };",
      "}",
      "",
      "export function describeCasePhase(snapshot: CaseSnapshot): { readonly slaHours: number; readonly banner: string } {",
      "  const definition = PHASE_DEFINITIONS[snapshot.phase];",
      "  return {",
      "    slaHours: definition.slaHours,",
      "    banner: definition.statusBanner(snapshot),",
      "  };",
      "}"
    ]
  },
  "expect": {
    "open_closed": "pass"
  }
}
