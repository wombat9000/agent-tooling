{
  "id": "single-responsibility-ui-component-bad",
  "description": "React checkout view component mixing raw fetch network calls, multi-step business pricing and tax calculation, localStorage persistence, and UI rendering in one file",
  "rubric": "solid",
  "files": {
    "types.ts": [
      "export interface CartLine {",
      "  readonly sku: string;",
      "  readonly title: string;",
      "  readonly unitPriceCents: number;",
      "  readonly quantity: number;",
      "}",
      "",
      "export interface CouponRule {",
      "  readonly code: string;",
      "  readonly percentOff: number;",
      "  readonly minSubtotalCents: number;",
      "}"
    ],
    "checkout-panel.tsx": [
      "import { useEffect, useState } from 'react';",
      "import type { CartLine, CouponRule } from './types';",
      "",
      "export interface CheckoutPanelProps {",
      "  readonly lines: readonly CartLine[];",
      "  readonly customerRegion: 'domestic' | 'eu' | 'intl';",
      "}",
      "",
      "export function CheckoutPanel({ lines, customerRegion }: CheckoutPanelProps) {",
      "  const [couponCode, setCouponCode] = useState(() => localStorage.getItem('checkout_coupon') ?? '');",
      "  const [activeCoupon, setActiveCoupon] = useState<CouponRule | null>(null);",
      "  const [statusMessage, setStatusMessage] = useState<string | null>(null);",
      "  const [isSubmitting, setIsSubmitting] = useState(false);",
      "",
      "  useEffect(() => {",
      "    localStorage.setItem('checkout_coupon', couponCode);",
      "    if (!couponCode.trim()) {",
      "      setActiveCoupon(null);",
      "      return;",
      "    }",
      "    void fetch(`/api/coupons/${encodeURIComponent(couponCode.trim())}`)",
      "      .then((res) => (res.ok ? res.json() : null))",
      "      .then((rule: CouponRule | null) => setActiveCoupon(rule))",
      "      .catch(() => setActiveCoupon(null));",
      "  }, [couponCode]);",
      "",
      "  const rawSubtotalCents = lines.reduce((sum, line) => sum + line.unitPriceCents * line.quantity, 0);",
      "  const totalUnits = lines.reduce((sum, line) => sum + line.quantity, 0);",
      "  const bulkDiscountCents = totalUnits >= 10 ? Math.round(rawSubtotalCents * 0.08) : 0;",
      "  const couponDiscountCents = activeCoupon && rawSubtotalCents >= activeCoupon.minSubtotalCents",
      "    ? Math.round((rawSubtotalCents - bulkDiscountCents) * (activeCoupon.percentOff / 100))",
      "    : 0;",
      "  const discountedCents = Math.max(0, rawSubtotalCents - bulkDiscountCents - couponDiscountCents);",
      "  const shippingCents = discountedCents >= 10_000 ? 0 : customerRegion === 'domestic' ? 795 : 2_495;",
      "  const taxRate = customerRegion === 'eu' ? 0.2 : customerRegion === 'domestic' ? 0.0825 : 0;",
      "  const taxCents = Math.round(discountedCents * taxRate);",
      "  const grandTotalCents = discountedCents + shippingCents + taxCents;",
      "",
      "  const handlePlaceOrder = async () => {",
      "    setIsSubmitting(true);",
      "    setStatusMessage(null);",
      "    try {",
      "      const response = await fetch('/api/orders', {",
      "        method: 'POST',",
      "        headers: { 'Content-Type': 'application/json' },",
      "        body: JSON.stringify({ lines, couponCode, customerRegion, grandTotalCents, taxCents, shippingCents }),",
      "      });",
      "      if (!response.ok) {",
      "        setStatusMessage(`Order failed (${response.status})`);",
      "        return;",
      "      }",
      "      const created = (await response.json()) as { orderId: string };",
      "      const prevHistory = JSON.parse(localStorage.getItem('recent_order_ids') ?? '[]') as string[];",
      "      localStorage.setItem('recent_order_ids', JSON.stringify([created.orderId, ...prevHistory].slice(0, 20)));",
      "      localStorage.removeItem('checkout_coupon');",
      "      await fetch('/api/analytics/events', {",
      "        method: 'POST',",
      "        headers: { 'Content-Type': 'application/json' },",
      "        body: JSON.stringify({ event: 'order_placed', orderId: created.orderId, grandTotalCents }),",
      "      });",
      "      setStatusMessage(`Order ${created.orderId} confirmed`);",
      "    } finally {",
      "      setIsSubmitting(false);",
      "    }",
      "  };",
      "",
      "  return (",
      "    <section className=\"checkout-panel\">",
      "      <h2>Order Summary</h2>",
      "      <ul>",
      "        {lines.map((line) => (",
      "          <li key={line.sku}>",
      "            {line.title} x{line.quantity} — ${(line.unitPriceCents * line.quantity / 100).toFixed(2)}",
      "          </li>",
      "        ))}",
      "      </ul>",
      "      <input value={couponCode} onChange={(e) => setCouponCode(e.target.value)} placeholder=\"Promo code\" />",
      "      <p>Total: ${(grandTotalCents / 100).toFixed(2)}</p>",
      "      <button type=\"button\" disabled={isSubmitting} onClick={handlePlaceOrder}>",
      "        {isSubmitting ? 'Placing order...' : 'Place order'}",
      "      </button>",
      "      {statusMessage && <p role=\"status\">{statusMessage}</p>}",
      "    </section>",
      "  );",
      "}"
    ]
  },
  "expect": {
    "single_responsibility": "fail"
  }
}
