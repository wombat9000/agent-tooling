{
  "id": "prod-demo-contamination-good",
  "description": "Production orders client resolves the upstream URL from environment configuration, fails cleanly if unset, and never bundles in-process stubs or demo overlays",
  "rubric": "integration-readiness",
  "files": {
    "config.ts": [
      "export interface OrdersApiConfig {",
      "  readonly baseUrl: string;",
      "}",
      "",
      "export function loadOrdersApiConfig(env: Readonly<Record<string, string | undefined>>): OrdersApiConfig {",
      "  const baseUrl = env.ORDERS_API_BASE_URL?.trim();",
      "  if (!baseUrl) {",
      "    throw new Error('ORDERS_API_BASE_URL must be configured');",
      "  }",
      "  return { baseUrl: baseUrl.replace(/\\/+$/, '') };",
      "}"
    ],
    "orders-client.ts": [
      "import type { OrdersApiConfig } from './config';",
      "",
      "export interface OrderSummary {",
      "  readonly id: string;",
      "  readonly customerName: string;",
      "  readonly totalCents: number;",
      "}",
      "",
      "export async function fetchOrders(config: OrdersApiConfig, authHeader: string): Promise<readonly OrderSummary[]> {",
      "  const response = await fetch(`${config.baseUrl}/api/orders`, {",
      "    headers: { Authorization: authHeader, Accept: 'application/json' },",
      "  });",
      "  if (!response.ok) {",
      "    throw new Error(`Orders API request failed with HTTP ${response.status}`);",
      "  }",
      "  return (await response.json()) as OrderSummary[];",
      "}"
    ],
    "orders-service.ts": [
      "import type { OrdersApiConfig } from './config';",
      "import { fetchOrders, type OrderSummary } from './orders-client';",
      "",
      "export async function listHighValueOrders(",
      "  config: OrdersApiConfig,",
      "  authHeader: string,",
      "  minCents: number,",
      "): Promise<readonly OrderSummary[]> {",
      "  const orders = await fetchOrders(config, authHeader);",
      "  return orders.filter((order) => order.totalCents >= minCents);",
      "}"
    ]
  },
  "expect": {
    "no_prod_fixture_or_demo_contamination": "pass"
  }
}
