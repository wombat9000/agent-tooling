{
  "id": "feature-envy-bad",
  "description": "SubscriptionRecord is a passive anemic data bag while BillingService and InvoiceCalculator repeatedly extract its internals to compute rules and state transitions externally",
  "rubric": "fowler-smells",
  "files": {
    "subscription-record.ts": [
      "export class SubscriptionRecord {",
      "  id: string;",
      "  seats: number;",
      "  pricePerSeatCents: number;",
      "  discountPercent: number;",
      "  state: 'active' | 'past_due' | 'cancelled';",
      "  failedPaymentAttempts: number;",
      "  graceDaysRemaining: number;",
      "",
      "  constructor(",
      "    id: string,",
      "    seats: number,",
      "    pricePerSeatCents: number,",
      "    discountPercent: number,",
      "    state: 'active' | 'past_due' | 'cancelled',",
      "    failedPaymentAttempts: number,",
      "    graceDaysRemaining: number,",
      "  ) {",
      "    this.id = id;",
      "    this.seats = seats;",
      "    this.pricePerSeatCents = pricePerSeatCents;",
      "    this.discountPercent = discountPercent;",
      "    this.state = state;",
      "    this.failedPaymentAttempts = failedPaymentAttempts;",
      "    this.graceDaysRemaining = graceDaysRemaining;",
      "  }",
      "}"
    ],
    "invoice-calculator.ts": [
      "import type { SubscriptionRecord } from './subscription-record';",
      "",
      "export function computeSubscriptionTotal(sub: SubscriptionRecord): number {",
      "  if (sub.state === 'cancelled') return 0;",
      "  const gross = sub.seats * sub.pricePerSeatCents;",
      "  const discount = Math.round(gross * (sub.discountPercent / 100));",
      "  const lateFee = sub.state === 'past_due' && sub.failedPaymentAttempts > 1 ? 1500 : 0;",
      "  return gross - discount + lateFee;",
      "}",
      "",
      "export function canAccessPremiumFeatures(sub: SubscriptionRecord): boolean {",
      "  if (sub.state === 'active') return sub.seats > 0;",
      "  if (sub.state === 'past_due') return sub.graceDaysRemaining > 0 && sub.failedPaymentAttempts < 3;",
      "  return false;",
      "}"
    ],
    "billing-service.ts": [
      "import type { SubscriptionRecord } from './subscription-record';",
      "",
      "export function applyFailedPayment(sub: SubscriptionRecord): void {",
      "  sub.failedPaymentAttempts += 1;",
      "  sub.graceDaysRemaining = Math.max(0, sub.graceDaysRemaining - 3);",
      "  if (sub.failedPaymentAttempts >= 3 || sub.graceDaysRemaining === 0) {",
      "    sub.state = 'cancelled';",
      "  } else {",
      "    sub.state = 'past_due';",
      "  }",
      "}",
      "",
      "export function upgradeSeats(sub: SubscriptionRecord, additionalSeats: number): void {",
      "  if (sub.state !== 'active' || sub.failedPaymentAttempts > 0) {",
      "    throw new Error('Cannot upgrade seats on delinquent subscription');",
      "  }",
      "  sub.seats += additionalSeats;",
      "  if (sub.seats >= 25 && sub.discountPercent < 15) {",
      "    sub.discountPercent = 15;",
      "  }",
      "}"
    ]
  },
  "expect": {
    "no_feature_envy_or_data_class_anemia": "fail"
  }
}
