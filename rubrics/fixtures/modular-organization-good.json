{
  "id": "modular-organization-good",
  "description": "Separates domain model, input parsing, persistence store, and workflow coordination into distinct, focused files",
  "rubric": "module-design",
  "files": {
    "booking.ts": [
      "export interface RoomBooking {",
      "  readonly id: string;",
      "  readonly roomCode: string;",
      "  readonly startHour: number;",
      "  readonly endHour: number;",
      "}",
      "",
      "export function bookingsOverlap(left: RoomBooking, right: RoomBooking): boolean {",
      "  return left.roomCode === right.roomCode && left.startHour < right.endHour && right.startHour < left.endHour;",
      "}"
    ],
    "booking-parser.ts": [
      "import type { RoomBooking } from './booking';",
      "",
      "export function parseBookingRequest(raw: Record<string, unknown>, id: string): RoomBooking {",
      "  const roomCode = typeof raw.roomCode === 'string' ? raw.roomCode.trim() : '';",
      "  const startHour = Number(raw.startHour);",
      "  const endHour = Number(raw.endHour);",
      "  if (!roomCode || !Number.isInteger(startHour) || !Number.isInteger(endHour) || endHour <= startHour) {",
      "    throw new Error('Invalid room booking payload');",
      "  }",
      "  return { id, roomCode, startHour, endHour };",
      "}"
    ],
    "booking-store.ts": [
      "import type { RoomBooking } from './booking';",
      "",
      "export interface BookingStore {",
      "  listForRoom(roomCode: string): Promise<readonly RoomBooking[]>;",
      "  save(booking: RoomBooking): Promise<void>;",
      "}"
    ],
    "booking-service.ts": [
      "import { bookingsOverlap, type RoomBooking } from './booking';",
      "import { parseBookingRequest } from './booking-parser';",
      "import type { BookingStore } from './booking-store';",
      "",
      "export async function reserveRoom(",
      "  store: BookingStore,",
      "  id: string,",
      "  rawPayload: Record<string, unknown>,",
      "): Promise<RoomBooking> {",
      "  const candidate = parseBookingRequest(rawPayload, id);",
      "  const existing = await store.listForRoom(candidate.roomCode);",
      "  if (existing.some((item) => bookingsOverlap(item, candidate))) {",
      "    throw new Error(`Room ${candidate.roomCode} is already booked for that slot`);",
      "  }",
      "  await store.save(candidate);",
      "  return candidate;",
      "}"
    ]
  },
  "expect": {
    "modular_organization": "pass"
  }
}
