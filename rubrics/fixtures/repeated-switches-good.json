{
  "id": "repeated-switches-good",
  "description": "Consolidates all membership tier rules into one authoritative policy table on membership-tier.ts instead of repeating switches across callers",
  "rubric": "fowler-smells",
  "files": {
    "membership-tier.ts": [
      "export type MembershipTier = 'starter' | 'growth' | 'enterprise';",
      "",
      "export interface TierPolicy {",
      "  readonly discountRate: number;",
      "  readonly supportSlaHours: number;",
      "  readonly maxSeats: number;",
      "  readonly renewalGraceDays: number;",
      "}",
      "",
      "const TIER_POLICIES: Record<MembershipTier, TierPolicy> = {",
      "  starter: { discountRate: 0, supportSlaHours: 48, maxSeats: 5, renewalGraceDays: 3 },",
      "  growth: { discountRate: 0.1, supportSlaHours: 12, maxSeats: 25, renewalGraceDays: 7 },",
      "  enterprise: { discountRate: 0.2, supportSlaHours: 2, maxSeats: 250, renewalGraceDays: 14 },",
      "};",
      "",
      "export function policyForTier(tier: MembershipTier): TierPolicy {",
      "  return TIER_POLICIES[tier];",
      "}"
    ],
    "pricing-service.ts": [
      "import { policyForTier, type MembershipTier } from './membership-tier';",
      "",
      "export function discountedPriceCents(tier: MembershipTier, baseCents: number): number {",
      "  const { discountRate } = policyForTier(tier);",
      "  return Math.round(baseCents * (1 - discountRate));",
      "}"
    ],
    "support-service.ts": [
      "import { policyForTier, type MembershipTier } from './membership-tier';",
      "",
      "export function canAddSeat(tier: MembershipTier, currentSeats: number): boolean {",
      "  return currentSeats < policyForTier(tier).maxSeats;",
      "}",
      "",
      "export function responseDeadlineHours(tier: MembershipTier): number {",
      "  return policyForTier(tier).supportSlaHours;",
      "}"
    ]
  },
  "expect": {
    "no_repeated_switches": "pass"
  }
}
