{
  "id": "immutable-state-local-builders-bad",
  "description": "Mutates caller-owned domain objects and arrays in place, leaks internal mutable collections across ownership boundaries, and shares global mutable domain state",
  "rubric": "domain-modelling",
  "files": {
    "order-tracker.ts": [
      "export interface OrderLine {",
      "  sku: string;",
      "  quantity: number;",
      "}",
      "",
      "export interface Order {",
      "  id: string;",
      "  status: 'draft' | 'confirmed';",
      "  lines: OrderLine[];",
      "}",
      "",
      "const recentOrders: Order[] = [];",
      "",
      "export function confirmOrder(order: Order, bonusSku?: string): Order {",
      "  order.status = 'confirmed';",
      "  if (bonusSku) {",
      "    order.lines.push({ sku: bonusSku, quantity: 1 });",
      "  }",
      "  recentOrders.push(order);",
      "  return order;",
      "}",
      "",
      "export function getRecentOrders(): Order[] {",
      "  return recentOrders;",
      "}"
    ]
  },
  "expect": {
    "immutable_state": "fail"
  }
}
