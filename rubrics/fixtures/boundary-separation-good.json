{
  "id": "boundary-separation-good",
  "description": "Keeps HTTP parsing/status mapping in the handler, persistence queries in the repository, and pure domain logic operating strictly on typed domain values",
  "rubric": "domain-modelling",
  "files": {
    "shipment-policy.ts": [
      "export type DeliverySpeed = 'standard' | 'express';",
      "",
      "export interface ShipmentRequest {",
      "  readonly weightGrams: number;",
      "  readonly speed: DeliverySpeed;",
      "  readonly insuredValueCents: number;",
      "}",
      "",
      "export type QuoteOutcome =",
      "  | { readonly kind: 'quoted'; readonly priceCents: number }",
      "  | { readonly kind: 'overweight'; readonly maxGrams: number };",
      "",
      "const MAX_WEIGHT_GRAMS = 25_000;",
      "",
      "export function calculateShipmentQuote(request: ShipmentRequest): QuoteOutcome {",
      "  if (request.weightGrams > MAX_WEIGHT_GRAMS) {",
      "    return { kind: 'overweight', maxGrams: MAX_WEIGHT_GRAMS };",
      "  }",
      "  const base = request.speed === 'express' ? 1_800 : 750;",
      "  const weightFee = Math.ceil(request.weightGrams / 1_000) * 120;",
      "  const insuranceFee = Math.round(request.insuredValueCents * 0.01);",
      "  return { kind: 'quoted', priceCents: base + weightFee + insuranceFee };",
      "}"
    ],
    "shipment-repository.ts": [
      "export interface SavedQuote {",
      "  readonly id: string;",
      "  readonly priceCents: number;",
      "}",
      "",
      "export interface SqlExecutor {",
      "  execute(sql: string, params: readonly unknown[]): Promise<void>;",
      "}",
      "",
      "export class ShipmentQuoteRepository {",
      "  private readonly db: SqlExecutor;",
      "",
      "  constructor(db: SqlExecutor) {",
      "    this.db = db;",
      "  }",
      "",
      "  async save(quote: SavedQuote): Promise<void> {",
      "    await this.db.execute(",
      "      'INSERT INTO shipment_quotes (id, price_cents) VALUES ($1, $2)',",
      "      [quote.id, quote.priceCents],",
      "    );",
      "  }",
      "}"
    ],
    "shipment-handler.ts": [
      "import { calculateShipmentQuote, type DeliverySpeed } from './shipment-policy';",
      "import type { ShipmentQuoteRepository } from './shipment-repository';",
      "",
      "export interface HttpQuoteRequest {",
      "  readonly quoteId: string;",
      "  readonly queryWeight: string;",
      "  readonly querySpeed: string;",
      "  readonly queryInsuredCents: string;",
      "}",
      "",
      "export async function handleQuoteHttp(repo: ShipmentQuoteRepository, req: HttpQuoteRequest) {",
      "  const weightGrams = Number(req.queryWeight);",
      "  const insuredValueCents = Number(req.queryInsuredCents);",
      "  const speed: DeliverySpeed | null = req.querySpeed === 'express' || req.querySpeed === 'standard' ? req.querySpeed : null;",
      "  if (!Number.isFinite(weightGrams) || weightGrams <= 0 || !Number.isFinite(insuredValueCents) || !speed) {",
      "    return { status: 400, body: { error: 'Invalid shipment parameters' } };",
      "  }",
      "  const outcome = calculateShipmentQuote({ weightGrams, speed, insuredValueCents });",
      "  if (outcome.kind === 'overweight') {",
      "    return { status: 422, body: { error: `Exceeds max weight of ${outcome.maxGrams}g` } };",
      "  }",
      "  await repo.save({ id: req.quoteId, priceCents: outcome.priceCents });",
      "  return { status: 201, body: { id: req.quoteId, priceCents: outcome.priceCents } };",
      "}"
    ]
  },
  "expect": {
    "boundary_separation": "pass"
  }
}
