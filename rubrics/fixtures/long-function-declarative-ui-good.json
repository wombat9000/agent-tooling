{
  "id": "long-function-declarative-ui-good",
  "description": "Declarative UI component grouping several short independent handlers and clean declarative markup composition",
  "mode": "file",
  "rubric": "fowler-smells",
  "files": {
    "profile-settings-panel.tsx": [
      "import { useState } from 'react';",
      "",
      "export interface ProfileDraft {",
      "  readonly displayName: string;",
      "  readonly timezone: string;",
      "  readonly emailAlerts: boolean;",
      "  readonly weeklyDigest: boolean;",
      "}",
      "",
      "export interface ProfileSettingsPanelProps {",
      "  readonly initial: ProfileDraft;",
      "  readonly timezones: readonly string[];",
      "  readonly onSave: (draft: ProfileDraft) => Promise<void>;",
      "  readonly onReset: () => void;",
      "}",
      "",
      "export function ProfileSettingsPanel({",
      "  initial,",
      "  timezones,",
      "  onSave,",
      "  onReset,",
      "}: ProfileSettingsPanelProps) {",
      "  const [draft, setDraft] = useState<ProfileDraft>(initial);",
      "  const [isSaving, setIsSaving] = useState(false);",
      "  const [statusMessage, setStatusMessage] = useState<string | null>(null);",
      "",
      "  const handleDisplayNameChange = (displayName: string) => {",
      "    setDraft((prev) => ({ ...prev, displayName }));",
      "  };",
      "",
      "  const handleTimezoneChange = (timezone: string) => {",
      "    setDraft((prev) => ({ ...prev, timezone }));",
      "  };",
      "",
      "  const handleToggleEmailAlerts = () => {",
      "    setDraft((prev) => ({ ...prev, emailAlerts: !prev.emailAlerts }));",
      "  };",
      "",
      "  const handleToggleWeeklyDigest = () => {",
      "    setDraft((prev) => ({ ...prev, weeklyDigest: !prev.weeklyDigest }));",
      "  };",
      "",
      "  const handleSubmit = async (event: { preventDefault: () => void }) => {",
      "    event.preventDefault();",
      "    setIsSaving(true);",
      "    setStatusMessage(null);",
      "    try {",
      "      await onSave(draft);",
      "      setStatusMessage('Settings saved.');",
      "    } finally {",
      "      setIsSaving(false);",
      "    }",
      "  };",
      "",
      "  const handleReset = () => {",
      "    setDraft(initial);",
      "    setStatusMessage(null);",
      "    onReset();",
      "  };",
      "",
      "  return (",
      "    <form onSubmit={handleSubmit} className=\"settings-panel\">",
      "      <header className=\"settings-header\">",
      "        <h2>Profile Settings</h2>",
      "        <p>Manage your display name, local timezone, and notification preferences.</p>",
      "      </header>",
      "      <section className=\"settings-section\">",
      "        <label htmlFor=\"display-name\">Display Name</label>",
      "        <input",
      "          id=\"display-name\"",
      "          value={draft.displayName}",
      "          onChange={(e) => handleDisplayNameChange(e.target.value)}",
      "        />",
      "      </section>",
      "      <section className=\"settings-section\">",
      "        <label htmlFor=\"timezone\">Timezone</label>",
      "        <select",
      "          id=\"timezone\"",
      "          value={draft.timezone}",
      "          onChange={(e) => handleTimezoneChange(e.target.value)}",
      "        >",
      "          {timezones.map((tz) => (",
      "            <option key={tz} value={tz}>",
      "              {tz}",
      "            </option>",
      "          ))}",
      "        </select>",
      "      </section>",
      "      <fieldset className=\"settings-section\">",
      "        <legend>Notifications</legend>",
      "        <label>",
      "          <input type=\"checkbox\" checked={draft.emailAlerts} onChange={handleToggleEmailAlerts} />",
      "          Email alerts for account activity",
      "        </label>",
      "        <label>",
      "          <input type=\"checkbox\" checked={draft.weeklyDigest} onChange={handleToggleWeeklyDigest} />",
      "          Weekly summary digest",
      "        </label>",
      "      </fieldset>",
      "      {statusMessage && <p role=\"status\">{statusMessage}</p>}",
      "      <footer className=\"settings-actions\">",
      "        <button type=\"button\" onClick={handleReset} disabled={isSaving}>",
      "          Reset",
      "        </button>",
      "        <button type=\"submit\" disabled={isSaving}>",
      "          {isSaving ? 'Saving...' : 'Save changes'}",
      "        </button>",
      "      </footer>",
      "    </form>",
      "  );",
      "}"
    ]
  },
  "expect": {
    "no_long_functions": "pass"
  }
}
