{
  "id": "solid-module-good",
  "description": "Cohesive multi-file invoice module with clear SRP and dependency inversion through focused repository and clock ports",
  "mode": "code",
  "rubric": "solid",
  "files": {
    "invoice.ts": [
      "export type InvoiceStatus = 'draft' | 'issued' | 'paid';",
      "",
      "export interface InvoiceLine {",
      "  readonly description: string;",
      "  readonly amountCents: number;",
      "}",
      "",
      "export interface Invoice {",
      "  readonly id: string;",
      "  readonly customerId: string;",
      "  readonly lines: readonly InvoiceLine[];",
      "  readonly status: InvoiceStatus;",
      "  readonly issuedAtIso: string | null;",
      "}",
      "",
      "export function invoiceTotalCents(invoice: Invoice): number {",
      "  return invoice.lines.reduce((sum, line) => sum + line.amountCents, 0);",
      "}",
      "",
      "export function issueInvoice(invoice: Invoice, issuedAtIso: string): Invoice {",
      "  if (invoice.status !== 'draft') {",
      "    throw new Error('Only draft invoices can be issued');",
      "  }",
      "  if (invoice.lines.length === 0) {",
      "    throw new Error('Cannot issue an empty invoice');",
      "  }",
      "  return { ...invoice, status: 'issued', issuedAtIso };",
      "}"
    ],
    "ports.ts": [
      "import type { Invoice } from './invoice';",
      "",
      "export interface InvoiceRepository {",
      "  findById(id: string): Promise<Invoice | null>;",
      "  save(invoice: Invoice): Promise<void>;",
      "}",
      "",
      "export interface Clock {",
      "  nowIso(): string;",
      "}"
    ],
    "invoice-service.ts": [
      "import { issueInvoice, type Invoice } from './invoice';",
      "import type { Clock, InvoiceRepository } from './ports';",
      "",
      "export class InvoiceService {",
      "  private readonly repository: InvoiceRepository;",
      "  private readonly clock: Clock;",
      "",
      "  constructor(repository: InvoiceRepository, clock: Clock) {",
      "    this.repository = repository;",
      "    this.clock = clock;",
      "  }",
      "",
      "  async issue(invoiceId: string): Promise<Invoice> {",
      "    const existing = await this.repository.findById(invoiceId);",
      "    if (!existing) {",
      "      throw new Error(`Invoice not found: ${invoiceId}`);",
      "    }",
      "    const issued = issueInvoice(existing, this.clock.nowIso());",
      "    await this.repository.save(issued);",
      "    return issued;",
      "  }",
      "}"
    ]
  },
  "expect": {
    "single_responsibility": "pass",
    "dependency_inversion": "pass"
  }
}
