{
  "id": "editorial-labels-good",
  "description": "Closed unions with human-readable names drive real routing, queue SLA, and matching behavior while editorial folder labels remain open free-text with optional suggestions",
  "mode": "file",
  "rubric": "api-design",
  "files": {
    "support-routing.ts": [
      "export type RoutingQueue = 'urgent-escalation' | 'billing-review' | 'standard-inbox';",
      "export type MatchOperator = 'exact' | 'contains' | 'starts-with';",
      "",
      "export const SUGGESTED_FOLDER_LABELS = ['Onboarding', 'Follow-up', 'Archive'] as const;",
      "",
      "export interface TicketRuleRequest {",
      "  readonly queue: RoutingQueue;",
      "  readonly matchOperator: MatchOperator;",
      "  readonly matchValue: string;",
      "  readonly folderLabel: string | null;",
      "}",
      "",
      "export interface QueuePolicy {",
      "  readonly slaMinutes: number;",
      "  readonly requiresSeniorReviewer: boolean;",
      "  readonly pagerChannel: string | null;",
      "}",
      "",
      "export function policyForQueue(queue: RoutingQueue): QueuePolicy {",
      "  switch (queue) {",
      "    case 'urgent-escalation':",
      "      return { slaMinutes: 15, requiresSeniorReviewer: true, pagerChannel: 'oncall-primary' };",
      "    case 'billing-review':",
      "      return { slaMinutes: 120, requiresSeniorReviewer: true, pagerChannel: null };",
      "    case 'standard-inbox':",
      "      return { slaMinutes: 480, requiresSeniorReviewer: false, pagerChannel: null };",
      "  }",
      "}",
      "",
      "export function matchesText(candidate: string, operator: MatchOperator, target: string): boolean {",
      "  const left = candidate.toLowerCase();",
      "  const right = target.toLowerCase();",
      "  switch (operator) {",
      "    case 'exact':",
      "      return left === right;",
      "    case 'contains':",
      "      return left.includes(right);",
      "    case 'starts-with':",
      "      return left.startsWith(right);",
      "  }",
      "}",
      "",
      "export function normalizeFolderLabel(raw: string | null | undefined): string | null {",
      "  const trimmed = raw?.trim();",
      "  return trimmed ? trimmed : null;",
      "}"
    ]
  },
  "expect": {
    "no_rigid_enums_for_editorial_labels": "pass"
  }
}
