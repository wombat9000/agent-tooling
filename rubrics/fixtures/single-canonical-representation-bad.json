{
  "id": "single-canonical-representation-bad",
  "description": "Announcement payload duplicates content across markdown, plain text, and pre-rendered HTML fields alongside server-computed UI display labels",
  "rubric": "api-design",
  "files": {
    "announcement-dto.ts": [
      "export type AnnouncementStatus = 'draft' | 'published' | 'archived';",
      "",
      "// Returning all three renderings avoids markdown parsing on lightweight clients.",
      "export interface AnnouncementResponse {",
      "  readonly id: string;",
      "  readonly title: string;",
      "  readonly renderedMarkup: string;",
      "  readonly renderedPlainText: string;",
      "  readonly renderedHtml: string;",
      "  readonly status: AnnouncementStatus;",
      "  readonly statusDisplayLabel: string;",
      "  readonly statusBadgeText: string;",
      "  readonly publishedAtIso: string | null;",
      "  readonly publishedAtFormatted: string;",
      "}"
    ],
    "announcement-mapper.ts": [
      "import type { AnnouncementResponse, AnnouncementStatus } from './announcement-dto';",
      "",
      "export interface AnnouncementRow {",
      "  readonly id: string;",
      "  readonly title: string;",
      "  readonly bodyMarkdown: string;",
      "  readonly status: AnnouncementStatus;",
      "  readonly publishedAtIso: string | null;",
      "}",
      "",
      "const STATUS_LABELS: Record<AnnouncementStatus, string> = {",
      "  draft: 'Draft (Not Visible)',",
      "  published: 'Live to All Users',",
      "  archived: 'Archived Notice',",
      "};",
      "",
      "export function toAnnouncementResponse(row: AnnouncementRow): AnnouncementResponse {",
      "  const plainText = row.bodyMarkdown.replace(/[#*_`]/g, '');",
      "  const html = `<p>${plainText}</p>`;",
      "  return {",
      "    id: row.id,",
      "    title: row.title,",
      "    renderedMarkup: row.bodyMarkdown,",
      "    renderedPlainText: plainText,",
      "    renderedHtml: html,",
      "    status: row.status,",
      "    statusDisplayLabel: STATUS_LABELS[row.status],",
      "    statusBadgeText: row.status.toUpperCase(),",
      "    publishedAtIso: row.publishedAtIso,",
      "    publishedAtFormatted: row.publishedAtIso ? row.publishedAtIso.slice(0, 10) : 'Not published yet',",
      "  };",
      "}"
    ],
    "announcement-routes.ts": [
      "import { toAnnouncementResponse, type AnnouncementRow } from './announcement-mapper';",
      "",
      "export function handleGetAnnouncement(row: AnnouncementRow | null) {",
      "  if (!row) {",
      "    return { status: 404, body: { error: 'Announcement not found' } };",
      "  }",
      "  return { status: 200, body: toAnnouncementResponse(row) };",
      "}"
    ]
  },
  "expect": {
    "single_canonical_representation": "fail"
  }
}
