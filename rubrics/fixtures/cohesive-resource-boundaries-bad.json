{
  "id": "cohesive-resource-boundaries-bad",
  "description": "Message template API DTO bolts on unrelated lifecycle picker hooks, unbuilt attachment placeholders, synthetic demo flags, and query-overloaded fields",
  "rubric": "api-design",
  "files": {
    "template-types.ts": [
      "// Includes picker suggestions and future attachment metadata to reduce client round-trips.",
      "export interface PlaceholderAttachmentMeta {",
      "  readonly filename: string;",
      "  readonly sizeBytes: number;",
      "  readonly storageKey: string | null;",
      "}",
      "",
      "export interface MessageTemplateDto {",
      "  readonly id: string;",
      "  readonly name: string;",
      "  readonly subject: string;",
      "  readonly bodyMarkdown: string;",
      "  readonly targetSubstages: readonly string[];",
      "  readonly suggestedCohortIds: readonly string[];",
      "  readonly upcomingPaymentPlanSummary?: string;",
      "  readonly attachments: readonly PlaceholderAttachmentMeta[];",
      "  readonly isDemo?: boolean;",
      "  readonly queryMatchScore?: number;",
      "  readonly pickerBadgeColor?: string;",
      "}"
    ],
    "template-service.ts": [
      "import type { MessageTemplateDto } from './template-types';",
      "",
      "export interface RawTemplateRow {",
      "  readonly id: string;",
      "  readonly name: string;",
      "  readonly subject: string;",
      "  readonly bodyMarkdown: string;",
      "}",
      "",
      "export function enrichTemplateForList(",
      "  row: RawTemplateRow,",
      "  options: { readonly forPicker: boolean; readonly searchTerm?: string },",
      "): MessageTemplateDto {",
      "  return {",
      "    id: row.id,",
      "    name: row.name,",
      "    subject: row.subject,",
      "    bodyMarkdown: row.bodyMarkdown,",
      "    targetSubstages: ['onboarding_step_2', 'renewal_check'],",
      "    suggestedCohortIds: options.forPicker ? ['cohort-west', 'cohort-enterprise'] : [],",
      "    upcomingPaymentPlanSummary: undefined,",
      "    attachments: [],",
      "    isDemo: row.id.startsWith('demo_'),",
      "    ...(options.searchTerm ? { queryMatchScore: 0.95 } : {}),",
      "    ...(options.forPicker ? { pickerBadgeColor: 'blue' } : {}),",
      "  };",
      "}"
    ],
    "template-routes.ts": [
      "import { enrichTemplateForList, type RawTemplateRow } from './template-service';",
      "",
      "export function handleListTemplates(",
      "  rows: readonly RawTemplateRow[],",
      "  query: { readonly picker?: string; readonly q?: string },",
      ") {",
      "  const forPicker = query.picker === 'true';",
      "  return {",
      "    status: 200,",
      "    body: { items: rows.map((row) => enrichTemplateForList(row, { forPicker, searchTerm: query.q })) },",
      "  };",
      "}"
    ]
  },
  "expect": {
    "cohesive_resource_boundaries": "fail"
  }
}
