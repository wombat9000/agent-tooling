{
  "id": "editorial-labels-bad",
  "description": "Hardcodes a closed code-owned enum and runtime allow-list for editorial content categories, rejecting custom user-supplied labels",
  "rubric": "api-design",
  "files": {
    "article-categories.ts": [
      "// Editorial team requested a fixed category list for consistent sidebar grouping and sorting.",
      "export const ALLOWED_ARTICLE_CATEGORIES = [",
      "  'Company News',",
      "  'Engineering Culture',",
      "  'Customer Stories',",
      "  'Product Updates',",
      "] as const;",
      "",
      "export type ArticleCategory = (typeof ALLOWED_ARTICLE_CATEGORIES)[number];",
      "",
      "export interface CreateArticleRequest {",
      "  readonly title: string;",
      "  readonly bodyMarkdown: string;",
      "  readonly category: ArticleCategory;",
      "}",
      "",
      "export function parseArticleCategory(raw: string): ArticleCategory {",
      "  if (!ALLOWED_ARTICLE_CATEGORIES.includes(raw as ArticleCategory)) {",
      "    throw new Error(`Unsupported article category: ${raw}`);",
      "  }",
      "  return raw as ArticleCategory;",
      "}",
      "",
      "export function groupArticlesByCategory<T extends { category: ArticleCategory }>(",
      "  articles: readonly T[],",
      "): Record<ArticleCategory, T[]> {",
      "  const grouped: Record<ArticleCategory, T[]> = {",
      "    'Company News': [],",
      "    'Engineering Culture': [],",
      "    'Customer Stories': [],",
      "    'Product Updates': [],",
      "  };",
      "  for (const article of articles) {",
      "    grouped[article.category].push(article);",
      "  }",
      "  return grouped;",
      "}"
    ],
    "article-repository.ts": [
      "export interface StoredArticle {",
      "  readonly id: string;",
      "  readonly title: string;",
      "  readonly bodyMarkdown: string;",
      "  readonly category: string;",
      "}",
      "",
      "export interface ArticleRepository {",
      "  save(article: StoredArticle): Promise<void>;",
      "  listAll(): Promise<readonly StoredArticle[]>;",
      "}"
    ],
    "article-service.ts": [
      "import { parseArticleCategory } from './article-categories';",
      "import type { ArticleRepository, StoredArticle } from './article-repository';",
      "",
      "export async function publishArticle(",
      "  repository: ArticleRepository,",
      "  input: { readonly id: string; readonly title: string; readonly bodyMarkdown: string; readonly category: string },",
      "): Promise<StoredArticle> {",
      "  const article: StoredArticle = {",
      "    id: input.id,",
      "    title: input.title.trim(),",
      "    bodyMarkdown: input.bodyMarkdown,",
      "    category: parseArticleCategory(input.category),",
      "  };",
      "  await repository.save(article);",
      "  return article;",
      "}"
    ]
  },
  "expect": {
    "no_rigid_enums_for_editorial_labels": "fail"
  }
}
