{
  "id": "immutable-state-bad",
  "description": "Domain class with mutable fields, in-place array mutations, and shared mutable static registry",
  "rubric": "domain-modelling",
  "files": {
    "cart.ts": [
      "export interface CartLine {",
      "  sku: string;",
      "  quantity: number;",
      "}",
      "",
      "export class ShoppingCart {",
      "  static activeCarts: ShoppingCart[] = [];",
      "  id: string;",
      "  lines: CartLine[] = [];",
      "  checkedOut = false;",
      "",
      "  constructor(id: string) {",
      "    this.id = id;",
      "    ShoppingCart.activeCarts.push(this);",
      "  }",
      "",
      "  addItem(sku: string, quantity: number): void {",
      "    const existing = this.lines.find((line) => line.sku === sku);",
      "    if (existing) {",
      "      existing.quantity += quantity;",
      "    } else {",
      "      this.lines.push({ sku, quantity });",
      "    }",
      "  }",
      "",
      "  checkout(): void {",
      "    this.checkedOut = true;",
      "  }",
      "}"
    ],
    "cart-summary.ts": [
      "import type { CartLine } from './cart';",
      "",
      "export function countLineItems(lines: readonly CartLine[]): number {",
      "  return lines.reduce((sum, line) => sum + line.quantity, 0);",
      "}"
    ]
  },
  "expect": {
    "immutable_state": "fail"
  }
}
