{
  "id": "minimal-http-surface-bad",
  "description": "Campaign API uses a bloated kitchen-sink super-DTO, overloaded exclusive-branch PATCH modes, and a bespoke previewHash token handshake gating send",
  "rubric": "api-design",
  "files": {
    "campaign-dto.ts": [
      "// Unified super-DTO allows all campaign screens and importers to share one endpoint.",
      "export interface CampaignMegaPayload {",
      "  readonly id: string;",
      "  readonly name?: string;",
      "  readonly subject?: string;",
      "  readonly bodyMarkdown?: string;",
      "  readonly surveyQuestions?: readonly string[];",
      "  readonly csvImportBatchId?: string;",
      "  readonly billingAccountSnapshot?: Record<string, unknown>;",
      "  readonly analyticsRollup?: Record<string, number>;",
      "  readonly archiveOnly?: boolean;",
      "  readonly resetDraftOnly?: boolean;",
      "  readonly previewHash?: string;",
      "  readonly previewToken?: string;",
      "  readonly previewExpiresAtIso?: string;",
      "  readonly rpcAction?: 'update' | 'preview' | 'send' | 'import_csv' | 'clone';",
      "}"
    ],
    "campaign-routes.ts": [
      "import type { CampaignMegaPayload } from './campaign-dto';",
      "",
      "export interface CampaignStore {",
      "  computePreviewHash(id: string): Promise<string>;",
      "  markSent(id: string): Promise<void>;",
      "  archive(id: string): Promise<void>;",
      "  resetDraft(id: string): Promise<void>;",
      "  applyFields(id: string, payload: CampaignMegaPayload): Promise<void>;",
      "}",
      "",
      "export async function handleCampaignRpc(store: CampaignStore, payload: CampaignMegaPayload) {",
      "  if (payload.rpcAction === 'send') {",
      "    const expectedHash = await store.computePreviewHash(payload.id);",
      "    if (!payload.previewHash || !payload.previewToken || payload.previewHash !== expectedHash) {",
      "      return { status: 409, body: { error: 'Must call preview endpoint and pass matching previewHash + previewToken' } };",
      "    }",
      "    await store.markSent(payload.id);",
      "    return { status: 200, body: { ok: true } };",
      "  }",
      "  if (payload.archiveOnly) {",
      "    await store.archive(payload.id);",
      "    return { status: 200, body: { archived: true } };",
      "  }",
      "  if (payload.resetDraftOnly) {",
      "    await store.resetDraft(payload.id);",
      "    return { status: 200, body: { reset: true } };",
      "  }",
      "  await store.applyFields(payload.id, payload);",
      "  return { status: 200, body: { updated: true } };",
      "}"
    ],
    "campaign-preview.ts": [
      "export function formatPreviewToken(campaignId: string, hash: string): string {",
      "  return `${campaignId}:${hash}`;",
      "}"
    ]
  },
  "expect": {
    "minimal_standard_http_surface": "fail"
  }
}
