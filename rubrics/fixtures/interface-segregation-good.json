{
  "id": "interface-segregation-good",
  "description": "Defines small focused printer and archiver contracts so each implementation and service depends only on the operations it actually uses",
  "rubric": "solid",
  "files": {
    "document-ports.ts": [
      "export interface PrintableDocument {",
      "  readonly id: string;",
      "  readonly title: string;",
      "  readonly content: string;",
      "}",
      "",
      "export interface DocumentPrinter {",
      "  print(doc: PrintableDocument): Promise<void>;",
      "}",
      "",
      "export interface DocumentArchiver {",
      "  archive(documentId: string): Promise<string>;",
      "}"
    ],
    "thermal-printer.ts": [
      "import type { DocumentPrinter, PrintableDocument } from './document-ports';",
      "",
      "export class ThermalLabelPrinter implements DocumentPrinter {",
      "  readonly printedIds: string[] = [];",
      "",
      "  async print(doc: PrintableDocument): Promise<void> {",
      "    this.printedIds.push(doc.id);",
      "  }",
      "}"
    ],
    "archiver-service.ts": [
      "import type { DocumentArchiver } from './document-ports';",
      "",
      "export async function archiveBatch(archiver: DocumentArchiver, ids: readonly string[]): Promise<string[]> {",
      "  const keys: string[] = [];",
      "  for (const id of ids) {",
      "    keys.push(await archiver.archive(id));",
      "  }",
      "  return keys;",
      "}"
    ]
  },
  "expect": {
    "interface_segregation": "pass"
  }
}
